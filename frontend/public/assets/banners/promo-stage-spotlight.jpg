<svg width="400" height="300" viewBox="0 0 400 300" fill="none" xmlns="http://www.w3.org/2000/svg">
  <rect width="400" height="300" fill="#0D0E11" />
  <polygon points="300,0 120,300 380,300" fill="url(#stage-beam)" opacity="0.6" />
  <!-- Singer on Stage Silhouette -->
  <ellipse cx="250" cy="180" rx="14" ry="18" fill="#18181B" />
  <path d="M 230 250 L 245 195 L 260 195 L 275 250 Z" fill="#18181B" />
  <line x1="250" y1="195" x2="265" y2="185" stroke="#FFFFFF" stroke-width="2" />
  <defs>
    <linearGradient id="stage-beam" x1="300" y1="0" x2="250" y2="300" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0.9" />
      <stop offset="60%" stop-color="#D4F63B" stop-opacity="0.4" />
      <stop offset="100%" stop-color="#D4F63B" stop-opacity="0" />
    </linearGradient>
  </defs>
</svg>
