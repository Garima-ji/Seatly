<svg width="400" height="400" viewBox="0 0 400 400" fill="none" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="arijit-grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#2D1B4E" />
      <stop offset="100%" stop-color="#140D26" />
    </linearGradient>
  </defs>
  <!-- Background Aura -->
  <circle cx="200" cy="200" r="180" fill="url(#arijit-grad)" />
  <!-- Silhouette Artist with Mic -->
  <circle cx="200" cy="140" r="45" fill="#E2E8F0" opacity="0.9" />
  <!-- Beard & Head Silhouette -->
  <path d="M 170 140 Q 200 200 230 140 Q 210 120 170 140 Z" fill="#334155" />
  <!-- Body / Kurta -->
  <path d="M 130 290 Q 200 230 270 290 L 290 400 L 110 400 Z" fill="#F8FAFC" opacity="0.95" />
  <!-- Mic Stand -->
  <line x1="210" y1="145" x2="230" y2="190" stroke="#0F172A" stroke-width="6" stroke-linecap="round" />
  <circle cx="232" cy="194" r="8" fill="#D4F63B" />
  <line x1="230" y1="190" x2="260" y2="400" stroke="#475569" stroke-width="4" />
</svg>
