# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
DATABASE_URL=postgresql://ticketuser:ticketpass@localhost:5432/ticketdb
# Or individual parts (used by docker-compose)
POSTGRES_USER=ticketuser
POSTGRES_PASSWORD=ticketpass
POSTGRES_DB=ticketdb

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_min_32_chars
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Hold & Waitlist TTLs ─────────────────────────────────────────────────────
HOLD_TTL_SECONDS=600           # 10 minutes
WAITLIST_OFFER_TTL_SECONDS=1800 # 30 minutes
MAX_SEATS_PER_ORDER=6

# ─── Email (SendGrid) ────────────────────────────────────────────────────────
# Sign up at https://sendgrid.com and create an API key
SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_FROM=noreply@yourdomain.com
# Optional: set a "from" display name
EMAIL_FROM_NAME=TicketBook

# ─── Waitlist offer token signing ─────────────────────────────────────────────
# Used to HMAC-sign waitlist offer links — must be secret & random
WAITLIST_TOKEN_SECRET=change_this_waitlist_token_secret_min_32_chars

# ─── Frontend URL (for waitlist offer links in emails) ────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
