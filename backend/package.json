{
  "name": "ticket-booking-backend",
  "version": "1.0.0",
  "description": "Ticket Booking Platform Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:down": "tsx src/db/migrate.ts down",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --forceExit",
    "test:concurrency": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern=concurrency --runInBand --forceExit",
    "test:waitlist": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern=waitlist --runInBand --forceExit",
    "test:booking": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern=booking --runInBand --forceExit",
    "seed": "tsx seed.ts",
    "docker:up": "docker compose up -d",
    "setup": "npm run docker:up && npm run migrate && npm run seed"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.6",
    "@sendgrid/mail": "^8.1.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.14.10",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/uuid": "^10.0.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "ioredis-mock": "^8.13.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nanoid": "^3.3.7",
    "node-cron": "^3.0.3",
    "pg": "^8.12.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.7.5",
    "typescript": "^5.5.3",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.2",
    "tsx": "^4.16.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "setupFilesAfterFramework": [],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    }
  }
}
